{
  "name": "s3-upload-proxy",
  "version": "1.0.0",
  "description": "Secure AWS S3 image/file upload proxy: encrypted pre-signed URLs, client upload links, file-type checks, malware scan hook, GPS stripping and bucket hardening. Express + Multer + AWS SDK v3.",
  "type": "module",
  "bin": {
    "s3proxy": "bin/s3proxy.js"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node bin/s3proxy.js serve",
    "dev": "node --watch bin/s3proxy.js serve",
    "demo": "node bin/s3proxy.js demo",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\""
  },
  "keywords": [
    "aws",
    "s3",
    "upload",
    "presigned-url",
    "express",
    "multer",
    "security"
  ],
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1168.0",
    "@aws-sdk/lib-storage": "^3.1168.0",
    "@aws-sdk/s3-presigned-post": "^3.1168.0",
    "@aws-sdk/s3-request-presigner": "^3.1168.0",
    "commander": "^15.1.0",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "multer": "^2.5.0"
  },
  "devDependencies": {
    "aws-sdk-client-mock": "^4.1.0"
  }
}
