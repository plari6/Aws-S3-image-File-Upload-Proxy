# ---- Core -------------------------------------------------------------
# 32+ random characters. "s3proxy init" generates one. Encrypts link tokens
# and peppers API key hashes: rotating it invalidates all links and keys.
APP_SECRET=
PORT=8080
# Public HTTPS address clients reach (used in upload links and CORS).
PUBLIC_URL=http://localhost:8080
# Behind a load balancer / nginx: number of trusted proxy hops (never "true").
# TRUST_PROXY=1
DATA_DIR=./data

# ---- Storage ------------------------------------------------------------
# s3 (production) or local (demo/dev, files on this disk)
STORAGE_DRIVER=local
S3_BUCKET=
AWS_REGION=us-east-1
# Optional key prefix inside the bucket, e.g. "client-docs"
S3_PREFIX=
# AES256 (SSE-S3) or aws:kms (SSE-KMS, per-key access control + CloudTrail)
S3_SSE=AES256
S3_KMS_KEY_ID=
# S3-compatible endpoints (MinIO, Cloudflare R2, LocalStack)
# S3_ENDPOINT=http://localhost:9000
# S3_FORCE_PATH_STYLE=true
# Credentials: use an IAM role (EC2/ECS/Lambda) or AWS_PROFILE; or set
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY for a dedicated least-privilege user.

# ---- Upload rules -------------------------------------------------------
MAX_FILE_SIZE=25mb
MAX_FILES_PER_REQUEST=10
ALLOWED_TYPES=jpg,png,webp,gif,heic,pdf,docx,xlsx,pptx,txt,csv
UPLOAD_URL_TTL=15m
DOWNLOAD_URL_TTL=5m
MAX_DOWNLOAD_URL_TTL=1h
# Remove GPS location from JPEG photos
STRIP_GPS=true
# Delete files that fail verification (false = keep, tagged scan=rejected)
DELETE_REJECTED=true

# ---- Client upload links -------------------------------------------------
LINK_TTL=7d
LINK_MAX_FILES=20
LINK_MAX_BYTES=200mb
BRAND_NAME=Secure document upload

# ---- Malware scan (optional, ClamAV clamd) -------------------------------
# CLAMAV_HOST=127.0.0.1
# CLAMAV_PORT=3310
# Refuse to accept files when the scanner is down
SCAN_REQUIRED=false

# ---- Limits & notifications ----------------------------------------------
RATE_LIMIT_WINDOW=60s
RATE_LIMIT_MAX=60
# Signed JSON event on every accepted / malware file (n8n, Make, Zapier, CRM)
WEBHOOK_URL=
WEBHOOK_SECRET=
